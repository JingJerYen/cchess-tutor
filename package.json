{
  "name": "cchess-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "analyze": "tsx pipeline/analyze.ts",
    "explain": "tsx pipeline/explain.ts",
    "server:dev": "tsx server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=server-dist/index.mjs --packages=external",
    "start": "node server-dist/index.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "fairy-stockfish-nnue.wasm": "^1.1.12",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0"
  }
}
